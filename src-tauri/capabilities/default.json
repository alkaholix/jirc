{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set granted to the main window and detached buffer windows.",
  "windows": ["main", "detached-*", "script-editor"],
  "permissions": [
    "core:default",
    "notification:default",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    "dialog:allow-open",
    "process:allow-restart",
    "updater:default"
  ]
}
